# ==============================================================================
# TELEMETRY INGESTION SERVICE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' for local development or set these variables
# directly in your production hosting platform (Docker, AWS ECS/EC2, Fly.io, etc.).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER SETTINGS
# ------------------------------------------------------------------------------
# In production containers, bind to 0.0.0.0 so external traffic reaches the container
HOST=0.0.0.0
PORT=3000

# Application environment: "development", "staging", or "production"
APP_ENV=production

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Production connection string format:
# postgres://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require
#
# Examples:
# Local/Docker compose: postgres://postgres:postgrespassword@db:5432/telementry_db
# Managed Cloud (AWS RDS, Supabase, Neon):
DATABASE_URL=postgres://db_user:SUPER_SECURE_PASSWORD@db-cluster.postgres.database.azure.com:5432/telemetry_db?sslmode=require

# SQLx Connection Pool Tuning for High Throughput
# Max open connections allocated to this service instance
DATABASE_MAX_CONNECTIONS=20
# Min idle connections maintained in the pool
DATABASE_MIN_CONNECTIONS=5
# Max lifetime of a connection in seconds
DATABASE_MAX_LIFETIME_SECS=1800
# Connection acquisition timeout in seconds
DATABASE_CONNECT_TIMEOUT_SECS=8

# ------------------------------------------------------------------------------
# 3. OBSERVABILITY & LOGGING
# ------------------------------------------------------------------------------
# Controls tracing and log verbosity. Recommended for production: "info"
# Options: error, warn, info, debug, trace
RUST_LOG=info,telementry_service=info,tower_http=info

# Set to 0 in production to prevent stack trace leaks in panic logs; 1 in dev
RUST_BACKTRACE=0

# Log format: "json" for cloud log aggregators (Datadog/CloudWatch), "pretty" for local
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# 4. SECURITY & CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend dashboard origins
# Example: https://dashboard.yourcompany.com,https://fleet.yourcompany.com
CORS_ALLOWED_ORIGINS=https://fleet-dashboard.bytebeam.io

# Optional shared secret or API key for authenticating edge device payloads
# DEVICE_INGEST_API_KEY=c79a8342fbd1e72e10a8c2f10b7849e6

# ------------------------------------------------------------------------------
# 5. METRICS & RATE LIMITING
# ------------------------------------------------------------------------------
# Max telemetry ingestion requests allowed per second per device/IP
RATE_LIMIT_RPS=100
# Request body payload size limit in bytes (e.g., 262144 = 256KB)
MAX_PAYLOAD_SIZE_BYTES=262144
